---
// Hero.astro — Vintage Video Game Title Screen
---

<section class="hero" id="home">
  <!-- ===== Background ===== -->
  <div class="hero-bg" aria-hidden="true">
    <img src="/hero-bg.jpg" alt="" class="hero-bg-img" loading="eager" fetchpriority="high" />
    <div class="hero-top-fade"></div>
    <div class="hero-bot-fade"></div>
    <div class="scanline-overlay"></div>
    <!-- Subtle Retro Stars -->
    <span class="star s1" aria-hidden="true">✦</span>
    <span class="star s2" aria-hidden="true">✦</span>
    <span class="star s3" aria-hidden="true">✦</span>
    <span class="star s4" aria-hidden="true">✦</span>
    <span class="star s5" aria-hidden="true">✦</span>
  </div>

  <!-- ===== Main Hero Content ===== -->
  <div class="hero-content container">
    <!-- Organizer Banner -->
    <div class="org-bar">
      <span class="org-chip">
        IEEE CS PESU &nbsp;•&nbsp; EEE Dept (PESU RRC) &nbsp;•&nbsp; C3I (PESU ECC)
      </span>
    </div>

    <!-- 3D Vintage Arcade Title -->
    <div class="title-wrap">
      <span class="corner-cross c-tl" aria-hidden="true">+</span>
      <span class="corner-cross c-tr" aria-hidden="true">+</span>
      <span class="corner-cross c-bl" aria-hidden="true">+</span>
      <span class="corner-cross c-br" aria-hidden="true">+</span>

      <h1 class="game-title" aria-label="CONFLUENCE">CONFLUENCE</h1>

      <!-- Hackathon Ribbon -->
      <div class="hackathon-ribbon">
        <span class="ribbon-star" aria-hidden="true">★</span>
        <span class="ribbon-text">NATIONAL LEVEL 24-HOUR HACKATHON</span>
        <span class="ribbon-star" aria-hidden="true">★</span>
      </div>
    </div>

    <!-- Date & Duration Badges -->
    <div class="hero-dates">
      <div class="date-pill">
        <span class="pill-icon" aria-hidden="true">📅</span>
        <strong>February 14–15, 2025</strong>
      </div>
      <div class="date-pill date-pill--cyan">
        <span class="pill-icon" aria-hidden="true">⚡</span>
        <strong>24 Hours Non-Stop</strong>
      </div>
      <div class="date-pill date-pill--gold">
        <span class="pill-icon" aria-hidden="true">📍</span>
        <strong>PES University RR Campus</strong>
      </div>
    </div>

    <!-- Tagline Box -->
    <div class="tagline-panel">
      <p class="hero-tagline">
        Where visionary collegiate minds converged for <strong>24 continuous hours</strong><br class="tagline-br" />
        of intense software architecture, rapid deployment, and breakthrough AI problem-solving.
      </p>
    </div>

    <!-- Arcade Action Buttons -->
    <div class="cta-row">
      <a href="#themes" class="vintage-btn vintage-btn--gold">
        <span>Explore 8 Themes</span>
        <span class="btn-arrow" aria-hidden="true">▸</span>
      </a>
      <a href="#teams" class="vintage-btn vintage-btn--cyan">
        <span>Top 40 Leaderboard</span>
        <span class="btn-arrow" aria-hidden="true">▸</span>
      </a>
      <a href="#about" class="vintage-btn vintage-btn--outline">
        <span>Event Overview</span>
      </a>
    </div>

    <!-- 4 Vintage Stat Panels -->
    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-head">
          <span class="stat-indicator yellow"></span>
          <span class="stat-sys-code">PRIZE_POOL</span>
        </div>
        <span class="stat-num">₹70,000</span>
        <span class="stat-sub">Total Cash Prizes</span>
      </div>

      <div class="stat-card">
        <div class="stat-head">
          <span class="stat-indicator cyan"></span>
          <span class="stat-sys-code">SPRINT_DURATION</span>
        </div>
        <span class="stat-num">24 Hours</span>
        <span class="stat-sub">Overnight Development</span>
      </div>

      <div class="stat-card">
        <div class="stat-head">
          <span class="stat-indicator pink"></span>
          <span class="stat-sys-code">LOCATION</span>
        </div>
        <span class="stat-num">13th Floor, BE Block</span>
        <span class="stat-sub">PES University Bengaluru</span>
      </div>

      <div class="stat-card">
        <div class="stat-head">
          <span class="stat-indicator green"></span>
          <span class="stat-sys-code">FINALIST_SQUADS</span>
        </div>
        <span class="stat-num">40 Teams</span>
        <span class="stat-sub">Shortlisted Competitors</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 100px 0 60px;
  }

  /* Background */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
    filter: saturate(1.15) brightness(0.85);
  }

  .hero-top-fade {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 45%;
    background: linear-gradient(180deg, rgba(3, 8, 22, 0.85) 0%, rgba(3, 8, 22, 0.2) 70%, transparent 100%);
  }

  .hero-bot-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(0deg, rgba(3, 8, 22, 0.95) 0%, transparent 100%);
  }

  .scanline-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3px,
      rgba(0, 0, 0, 0.08) 3px,
      rgba(0, 0, 0, 0.08) 4px
    );
  }

  /* Stars */
  .star {
    position: absolute;
    color: #ffffff;
    pointer-events: none;
    animation: twinkle 3s infinite ease-in-out;
    z-index: 2;
  }

  .s1 { top: 18%; left: 15%; font-size: 1rem; animation-delay: 0s; opacity: 0.9; }
  .s2 { top: 24%; left: 82%; font-size: 1.2rem; animation-delay: 0.8s; opacity: 0.7; }
  .s3 { top: 12%; left: 52%; font-size: 0.8rem; animation-delay: 1.5s; opacity: 0.85; }
  .s4 { top: 38%; left: 8%; font-size: 0.9rem; animation-delay: 0.4s; opacity: 0.6; }
  .s5 { top: 32%; left: 90%; font-size: 1.1rem; animation-delay: 2.1s; opacity: 0.8; }

  @keyframes twinkle {
    0%, 100% { opacity: 0.3; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.1); }
  }

  /* Hero Content */
  .hero-content {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Organizer Chip */
  .org-bar {
    margin-bottom: 1.25rem;
  }

  .org-chip {
    display: inline-block;
    font-family: var(--font-retro);
    font-size: 1rem;
    letter-spacing: 0.08em;
    color: var(--neon-cyan);
    background: rgba(0, 212, 255, 0.08);
    border: 1px solid rgba(0, 212, 255, 0.35);
    padding: 0.3rem 1.1rem;
    border-radius: 999px;
    box-shadow: 0 0 12px rgba(0, 212, 255, 0.15);
  }

  /* 3D Title Wrap */
  .title-wrap {
    position: relative;
    padding: 1.25rem 2rem;
    margin-bottom: 1.5rem;
  }

  .corner-cross {
    position: absolute;
    font-family: var(--font-retro);
    font-size: 1.3rem;
    color: var(--neon-cyan);
    opacity: 0.6;
    line-height: 1;
  }

  .c-tl { top: 0; left: 0; }
  .c-tr { top: 0; right: 0; }
  .c-bl { bottom: 0; left: 0; }
  .c-br { bottom: 0; right: 0; }

  .game-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 6.2rem);
    font-weight: 900;
    letter-spacing: 0.06em;
    line-height: 1;
    color: #ffffff;
    margin: 0;
    text-shadow:
      0 1px 0 #b3e4ff,
      0 2px 0 #7dc8f0,
      0 3px 0 #4aacd8,
      0 4px 0 #2890c0,
      0 5px 0 #1874a8,
      0 6px 0 #0d5890,
      0 7px 0 #083f6a,
      0 8px 0 #052948,
      0 10px 20px rgba(0, 0, 0, 0.8),
      0 0 40px rgba(0, 212, 255, 0.7);
  }

  /* Hackathon Ribbon */
  .hackathon-ribbon {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: linear-gradient(90deg, #f59e0b 0%, #fbbf24 50%, #f59e0b 100%);
    color: #030818;
    padding: 0.35rem 1.4rem;
    border-radius: 4px;
    margin-top: 0.75rem;
    box-shadow: 0 4px 14px rgba(245, 158, 11, 0.4);
  }

  .ribbon-star {
    font-size: 0.85rem;
    color: #030818;
  }

  .ribbon-text {
    font-family: var(--font-retro);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  /* Dates & Duration */
  .hero-dates {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }

  .date-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-retro);
    font-size: 1.05rem;
    letter-spacing: 0.05em;
    color: #e0f4ff;
    background: rgba(10, 22, 50, 0.75);
    border: 1px solid rgba(0, 212, 255, 0.3);
    padding: 0.35rem 0.9rem;
    border-radius: 6px;
  }

  .date-pill--cyan {
    color: var(--neon-cyan);
    border-color: rgba(0, 212, 255, 0.5);
  }

  .date-pill--gold {
    color: var(--arcade-yellow);
    border-color: rgba(251, 191, 36, 0.4);
  }

  .pill-icon {
    font-size: 0.95rem;
  }

  /* Tagline */
  .tagline-panel {
    max-width: 680px;
    margin-bottom: 1.75rem;
  }

  .hero-tagline {
    font-size: 1.05rem;
    color: #cadbee;
    line-height: 1.6;
    margin: 0;
  }

  .hero-tagline strong {
    color: #ffffff;
  }

  @media (max-width: 600px) {
    .tagline-br {
      display: none;
    }
  }

  /* CTA Buttons */
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    margin-bottom: 2.75rem;
  }

  .vintage-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-retro);
    font-size: 1.15rem;
    letter-spacing: 0.06em;
    font-weight: 700;
    text-decoration: none;
    padding: 0.65rem 1.35rem;
    border-radius: 6px;
    transition: transform 0.18s, box-shadow 0.18s, background 0.18s;
  }

  .vintage-btn--gold {
    background: var(--arcade-yellow);
    color: #030818;
    border: 1px solid var(--arcade-yellow);
    box-shadow: 0 0 16px rgba(251, 191, 36, 0.4);
  }

  .vintage-btn--gold:hover {
    background: #fcd34d;
    transform: translateY(-2px);
    box-shadow: 0 0 24px rgba(251, 191, 36, 0.7);
  }

  .vintage-btn--cyan {
    background: rgba(0, 212, 255, 0.15);
    color: var(--neon-cyan);
    border: 1px solid var(--neon-cyan);
    box-shadow: 0 0 14px rgba(0, 212, 255, 0.25);
  }

  .vintage-btn--cyan:hover {
    background: rgba(0, 212, 255, 0.3);
    transform: translateY(-2px);
    box-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
  }

  .vintage-btn--outline {
    background: rgba(255, 255, 255, 0.05);
    color: #cadbee;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .vintage-btn--outline:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .btn-arrow {
    font-size: 0.95rem;
  }

  /* Stat Grid */
  .stat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    width: 100%;
    max-width: 820px;
  }

  @media (min-width: 768px) {
    .stat-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-card {
    background: rgba(10, 22, 50, 0.82);
    border: 1px solid rgba(0, 212, 255, 0.25);
    border-radius: 8px;
    padding: 1rem 0.9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    backdrop-filter: blur(10px);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.4);
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }

  .stat-card:hover {
    transform: translateY(-3px);
    border-color: var(--neon-cyan);
    box-shadow: 0 6px 22px rgba(0, 212, 255, 0.25);
  }

  .stat-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .stat-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .stat-indicator.yellow { background: var(--arcade-yellow); }
  .stat-indicator.cyan   { background: var(--neon-cyan); }
  .stat-indicator.pink   { background: var(--neon-pink); }
  .stat-indicator.green  { background: var(--pixel-green); }

  .stat-sys-code {
    font-family: var(--font-retro);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--text-soft);
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
  }

  .stat-sub {
    font-size: 0.78rem;
    color: var(--text-mid);
    line-height: 1.3;
  }
</style>
