---
// index.astro - Confluence 2025 Refactored Single-Page Website
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Themes from '../components/Themes.astro';
import Timeline from '../components/Timeline.astro';
import Teams from '../components/Teams.astro';
import Sponsors from '../components/Sponsors.astro';
import Faqs from '../components/Faqs.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="CONFLUENCE 2025 | 24-Hour National Hackathon by IEEE CS PESU"
  description="Official retrospective & hall of fame for Confluence 2025, the 24-hour national hackathon by IEEE Computer Society PES University. 40 finalist teams, 8 AI tracks, 70,000 INR prize pool."
>
  <Header />
  <main id="main-content">
    <Hero />
    <About />
    <Themes />
    <Timeline />
    <Teams />
    <Sponsors />
    <Faqs />
    <Contact />
  </main>
  <Footer />
</Layout>

<style>
  #main-content {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
  }
</style>